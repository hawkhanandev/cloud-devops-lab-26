global:
  slack_api_url: '{{ vault_slack_webhook_url }}'
  resolve_timeout: 5m

route:
  group_by: ['alertname', 'job']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: 'slack-alerts'

receivers:
  - name: 'slack-alerts'
    slack_configs:
      - channel: '#devops-alerts'
        send_resolved: true
        title: '{% raw %}{{ template "slack.default.title" . }}{% endraw %}'
        text: >-
          {% raw %}{{ range .Alerts }}
            *Alert:* {{ .Annotations.summary }}
            *Description:* {{ .Annotations.description }}
            *Severity:* {{ .Labels.severity }}
          {{ end }}{% endraw %}
